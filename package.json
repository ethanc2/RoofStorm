{
  "name": "stormroute",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "dev:mobile": "npm -w apps/mobile run start",
    "db:up": "docker compose up -d",
    "db:migrate": "npm -w apps/api run migrate",
    "typecheck": "npm -ws run typecheck --if-present",
    "test": "vitest run",
    "build": "npm -w apps/api run build && npm -w apps/web run build"
  },
  "devDependencies": { "typescript": "^5.6.3", "vitest": "^2.1.4" }
}

