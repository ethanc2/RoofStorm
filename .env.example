# ---------- apps/api ----------
DATABASE_URL=postgres://stormroute:stormroute@localhost:5432/stormroute
REDIS_URL=redis://localhost:6379
PORT=4000
# openssl rand -base64 32   (both of these)
JWT_SECRET=
KEY_ENCRYPTION_KEY=

# Google Maps Platform — SERVER key, restrict by IP. Enable: Geocoding API, Routes API, Solar API, Street View Static API, Places API (New)
GOOGLE_MAPS_SERVER_KEY=
# Optional: Street View URL signing secret (Credentials → "URL signing secret" for the Static APIs)
GOOGLE_STREETVIEW_SIGNING_SECRET=
# Optional: Route Optimization API for routes > 25 stops. Requires a service account with roles/routeoptimization.editor.
# Leave blank to use the local solver for ordering (Routes API still draws the road geometry).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Third parties that are configured per company in the admin UI (keys stored encrypted in Postgres): JobNimbus, Swath, Regrid
SWATH_API_URL=https://swathapi.com
JOBNIMBUS_BASE_URL=https://app.jobnimbus.com/api1

# ---------- apps/web ----------
# Google Maps BROWSER key, restrict by HTTP referrer. Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID with vector rendering (Cloud Console → Map Management) — needed for AdvancedMarkerElement
VITE_GOOGLE_MAP_ID=
VITE_API_URL=http://localhost:4000

# ---------- apps/mobile ----------
# Native SDK keys, restricted by Android package + SHA-1 / iOS bundle id. Enable: Maps SDK for Android, Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_API_URL=http://localhost:4000

